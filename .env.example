# Nextcloud (docker-compose uses these)
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=adminpass
NEXTCLOUD_TRUSTED_DOMAINS=localhost nextcloud

# Backend -> Nextcloud OCS provisioning API credentials
# IMPORTANT: do not hardcode in code. Use env vars.
# Docker 내부에서는 'nextcloud' 호스트명 사용
NEXTCLOUD_BASE_URL=http://nextcloud
NEXTCLOUD_USERNAME=admin
NEXTCLOUD_PASSWORD=adminpass

# Nextcloud auto init (groups/users/quota)
NC_AUTO_INIT=true
NC_AUTO_INIT_PASSWORD=S3curePass_2026!
NC_AUTO_INIT_QUOTA=100 MB

# Frontend build-time config (docker build args)
VITE_API_BASE_URL=http://localhost:8080
VITE_SOCKET_URL=http://localhost:9092

# Usage monitoring settings
# Polling interval in milliseconds (default: 30000 = 30 seconds)
# Set lower for more frequent updates (e.g., 10000 = 10 seconds)
USAGE_REFRESH_DELAY_MS=10000

# Default quota in bytes (default: 100MB)
USAGE_QUOTA_BYTES_DEFAULT=104857600

# Webhook settings (for real-time updates)
# Enable file monitoring in Nextcloud container (requires inotify-tools)
MONITOR_ENABLED=true
WEBHOOK_URL=http://backend:8080/api/webhooks/nextcloud

